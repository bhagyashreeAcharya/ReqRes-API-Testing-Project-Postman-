		{
			"name": "Update User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 OK\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Parse request body and response\r",
							"var requestData = JSON.parse(pm.request.body.raw);\r",
							"var responseData = pm.response.json();\r",
							"\r",
							"// Validate response matches request (dynamic validation)\r",
							"pm.test(\"Response name matches request name\", function () {\r",
							"    pm.expect(responseData.name).to.eql(requestData.name);\r",
							"});\r",
							"\r",
							"pm.test(\"Response job matches request job\", function () {\r",
							"    pm.expect(responseData.job).to.eql(requestData.job);\r",
							"});\r",
							"\r",
							"// Validate updatedAt exists\r",
							"pm.test(\"Response contains updatedAt timestamp\", function () {\r",
							"    pm.expect(responseData.updatedAt).to.exist;\r",
							"});\r",
							"\r",
							"pm.test(\"updatedAt is not empty\", function () {\r",
							"    pm.expect(responseData.updatedAt).to.not.be.empty;\r",
							"});\r",
							"\r",
							"// Performance test\r",
							"pm.test(\"Response time is less than 2000 ms\", function () {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
